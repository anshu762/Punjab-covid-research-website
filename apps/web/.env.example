# Database (Neon Postgres)
DATABASE_URL="postgresql://user:password@ep-cool-pooler.us-east-2.aws.neon.tech/epilens?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-cool.us-east-2.aws.neon.tech/epilens?sslmode=require"

# Auth.js (NextAuth v5)
AUTH_SECRET="development-auth-secret-min-32-chars-for-epilens"
AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Optional Google OAuth (Demo credentials provider works without Google keys)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Compute Service
COMPUTE_URL="http://localhost:8000"
NEXT_PUBLIC_COMPUTE_PUBLIC_URL="http://localhost:8000"
COMPUTE_SHARED_SECRET="epilens-local-internal-compute-secret"

# Cron Cleanup Secret
CRON_SECRET="epilens-local-cron-secret"

# OpenRouter (Phase 5)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.0-flash-001"
OPENROUTER_FALLBACK_MODELS="meta-llama/llama-3.3-70b-instruct"

# Author Branding (Optional footer links)
NEXT_PUBLIC_AUTHOR_NAME="EpiLens Researcher"
NEXT_PUBLIC_AUTHOR_URL="https://github.com/anshu762/Punjab-covid-research-website"
