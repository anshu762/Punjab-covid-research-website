# ==============================================================================
# EpiLens Monorepo — Central Environment Variables Reference
# ==============================================================================
# This file lists every environment variable across the entire project.
#
# QUICK REFERENCE:
# - apps/web/.env       -> Next.js Web Frontend & BFF API Handlers
# - apps/compute/.env   -> Python FastAPI Computational Microservice
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# Neon me free project banayein: https://console.neon.tech
#
# DATABASE_URL (for web): Pooled connection (ends with "-pooler")
# DIRECT_URL   (for web migrations): Direct connection (without "-pooler")
# DATABASE_URL (for compute): Direct connection (without "-pooler")
DATABASE_URL="postgresql://user:password@ep-cool-pooler.us-east-2.aws.neon.tech/epilens?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-cool.us-east-2.aws.neon.tech/epilens?sslmode=require"

# ------------------------------------------------------------------------------
# 2. WEB AUTHENTICATION (Auth.js v5 / NextAuth)
# ------------------------------------------------------------------------------
# AUTH_SECRET: 32+ character random secret string
AUTH_SECRET="9fa52f929d1f8cd4704d629e174b67341a003b9aab82813d"

# AUTH_URL / APP_URL:
# Local: http://localhost:3000
# Production: https://your-project.vercel.app
AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# (Optional) Google OAuth credentials.
# Leave blank to use instant 1-Click Guest Demo Login without Google.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ------------------------------------------------------------------------------
# 3. COMPUTE MICROSERVICE (FastAPI on Railway)
# ------------------------------------------------------------------------------
# COMPUTE_URL / NEXT_PUBLIC_COMPUTE_PUBLIC_URL:
# Local: http://localhost:8000
# Production: https://your-compute.up.railway.app
COMPUTE_URL="http://localhost:8000"
NEXT_PUBLIC_COMPUTE_PUBLIC_URL="http://localhost:8000"

# COMPUTE_SHARED_SECRET: Must match between web and compute services!
COMPUTE_SHARED_SECRET="2fd3dbf391729b8303c17784046769c803fd6cdc0d00130e"

# ALLOWED_ORIGINS (in apps/compute/.env): Comma-separated allowed frontend URLs
ALLOWED_ORIGINS="http://localhost:3000,https://your-project.vercel.app"

# ------------------------------------------------------------------------------
# 4. MAINTENANCE & AI (Optional)
# ------------------------------------------------------------------------------
CRON_SECRET="45b531428fa64b0bc72287eb237256c3efa56b28f2d1c1d9"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.0-flash-001"
OPENROUTER_FALLBACK_MODELS="meta-llama/llama-3.3-70b-instruct"
